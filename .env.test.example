NODE_ENV=test
PORT=8001

# Database: use a dedicated test database/cluster, never production.
DBURL=mongodb+srv://<username>:<password>@<cluster>/<test_database>?retryWrites=true&w=majority
DNS_SERVERS=8.8.8.8,1.1.1.1

# Auth
JWT_SECRET=<test-only-jwt-secret>
EXPIRES_IN=24h
TOKEN_RENEW_WHEN_REMAINING=3600

# Public URLs for the test frontend/backend.
FRONT_URL=https://test-app.example.com/talent/
ADMIN_PANEL_URL=https://test-app.example.com/talent/
BASE_URL=https://test-api.example.com
API_URL=https://test-api.example.com
ATTACHMENT_BASE_PATH=

# Email: use test mailbox credentials for test emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test-smtp-user@example.com
SMTP_PASS=<test-smtp-password>
FROM=test-smtp-user@example.com
HR_EMAIL=test-hr@example.com
TEST_SEED_PASSWORD=Test@12345

# Google Drive: use a test folder and test credentials.
GOOGLE_DRIVE_FOLDER_ID=<test-drive-folder-id>
GOOGLE_DRIVE_CLIENT_ID=<test-google-client-id>
GOOGLE_DRIVE_CLIENT_SECRET=<test-google-client-secret>
GOOGLE_DRIVE_REFRESH_TOKEN=<test-google-refresh-token>
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_IMPERSONATE_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000

# Mongo backups: use a test Drive folder, never the production backup folder.
MONGO_BACKUP_ENABLED=true
MONGO_BACKUP_CRON=30 23 * * *
MONGO_BACKUP_TIMEZONE=Asia/Kolkata
MONGO_BACKUP_LOCAL_DIR=src/uploads/mongo-backups-test
MONGO_BACKUP_UPLOAD_TO_DRIVE=true
MONGO_BACKUP_RETENTION_DAYS=5
MONGO_BACKUP_DRIVE_FOLDER_ID=<test-backup-drive-folder-id>
MONGODUMP_PATH=mongodump
